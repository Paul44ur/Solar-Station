# Solar: clause picker shown when a devil summons a contract, and the text written onto the contract.
devil-contract-menu-title = Contract From Below
devil-contract-menu-prompt = Write the terms of this deal. Prices are what the mortal gives up. Gifts are what they get in return.
devil-contract-menu-prices = Prices (taken from the mortal)
devil-contract-menu-gifts = Gifts (granted to the mortal)
devil-contract-menu-clause = {$name} ({$weight})
devil-contract-menu-weight = Balance of the deal: {$weight}. It must be 0 or higher, or no mortal can sign it.
devil-contract-menu-confirm = Bind the contract
devil-contract-choose-clauses-verb = Choose clauses
devil-contract-locked = The leather refuses your commands.

devil-contract-clause-line = Contractee: {$name}
    {"["}color=#999999]{"["}italic]{$desc}{"["}/italic]{"["}/color]

devil-contract-content-chosen = This binding contract made this day between:

            - The Infernal Party (Hereinafter "Contractor")
            - The Mortal Party (Hereinafter "Contractee")

            {"["}bold]Clauses of Binding:{"["}/bold]
            {"["}italic]The Contractee agrees to the following terms{"["}/italic{"]"}

            {$clauses}

            {"["}italic]All clauses come into effect upon signing of this paper by both parties.{"["}/italic]
            {"["}italic]{"["}color=#ac3a0d]Clauses may not be broken. Ever.{"["}/color]{"["}/italic]

