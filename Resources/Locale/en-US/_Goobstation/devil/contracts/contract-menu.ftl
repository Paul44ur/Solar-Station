# Solar: clause picker shown when a devil summons a contract.
devil-contract-menu-title = Contract From Below
devil-contract-menu-prompt = Choose the clauses of this contract. Hover a clause to see what it does.
devil-contract-menu-clause = {$name} ({$weight})
devil-contract-menu-weight = Contract weight: {$weight}. It must be 0 or higher to be signed.
devil-contract-menu-confirm = Bind the contract
devil-contract-choose-clauses-verb = Choose clauses
devil-contract-locked = The leather refuses your commands.

devil-contract-content-chosen = This binding contract made this day between:

            - The Infernal Party (Hereinafter "Contractor")
            - The Mortal Party (Hereinafter "Contractee")

            {"["}bold]Clauses of Binding:{"["}/bold]
            {"["}italic]The following parties give up the following possessions{"["}/italic{"]"}

            {$clauses}

            {"["}italic]All clauses come into effect upon signing of this paper by both parties.{"["}/italic]
            {"["}italic]{"["}color=#ac3a0d]Clauses may not be broken. Ever.{"["}/color]{"["}/italic]

devil-clause-name-soulownership = Soul Ownership
devil-clause-desc-soulownership = Transfers ownership of the contractee's soul to you.
devil-clause-name-weakness = Weakness
devil-clause-desc-weakness = Halves all damage the contractee takes, but holy damage hurts more.
devil-clause-name-fearoffire = Fear of Fire
devil-clause-desc-fearoffire = The contractee becomes immune to fire.
devil-clause-name-brokeness = Brokeness
devil-clause-desc-brokeness = Grants the contractee a pair of very fancy shoes.
devil-clause-name-slaughter = Slaughter
devil-clause-desc-slaughter = Gives the contractee a bottle of blood that summons a slaughter demon.
devil-clause-name-fearofdeath = Fear of Death
devil-clause-desc-fearofdeath = The contractee has no critical state. They stand, or they die.
devil-clause-name-fearoflight = Fear of Light
devil-clause-desc-fearoflight = The contractee becomes immune to flashes.
devil-clause-name-fearofelectricity = Fear of Electricity
devil-clause-desc-fearofelectricity = The contractee becomes immune to electric shocks.
devil-clause-name-gluttony = Gluttony
devil-clause-desc-gluttony = The contractee no longer needs food or water.
devil-clause-name-fearofdrowning = Fear of Drowning
devil-clause-desc-fearofdrowning = The contractee no longer needs to breathe.
devil-clause-name-fearofclowns = Fear of Clowns
devil-clause-desc-fearofclowns = The contractee can no longer slip.
devil-clause-name-fearofcrushing = Fear of Crushing
devil-clause-desc-fearofcrushing = The contractee becomes immune to pressure damage.
devil-clause-name-fearoffreezing = Fear of Freezing
devil-clause-desc-fearoffreezing = The contractee becomes immune to the cold.
devil-clause-name-greed = Greed
devil-clause-desc-greed = Grants the contractee a pile of cash.
devil-clause-name-pain = Pain
devil-clause-desc-pain = The contractee feels no pain.
devil-clause-name-chance = Chance
devil-clause-desc-chance = Gives the contractee a completely random clause.
devil-clause-name-shadows = Shadows
devil-clause-desc-shadows = Makes the contractee invisible.
devil-clause-name-humanity = Humanity
devil-clause-desc-humanity = Turns the contractee into a rat for 10 minutes.
devil-clause-name-strength = Strength
devil-clause-desc-strength = The contractee takes double damage.
devil-clause-name-mimes = Mimes
devil-clause-desc-mimes = Lets the contractee create an invisible wall.
devil-clause-name-diseases = Diseases
devil-clause-desc-diseases = The contractee becomes immune to diseases and curses.
devil-clause-name-willtofight = Will to Fight
devil-clause-desc-willtofight = Permanently pacifies the contractee.
devil-clause-name-buckling = Buckling
devil-clause-desc-buckling = The contractee can never be buckled to a chair or bed.
devil-clause-name-mass = Mass
devil-clause-desc-mass = The contractee can't be dragged or hide inside containers.
devil-clause-name-sight = Sight
devil-clause-desc-sight = Permanently blinds the contractee.
devil-clause-name-tardiness = Tardiness
devil-clause-desc-tardiness = Gives the contractee a slight speed boost.
devil-clause-name-foreigners = Foreigners
devil-clause-desc-foreigners = The contractee understands and speaks every language.
devil-clause-name-intelligence = Intelligence
devil-clause-desc-intelligence = Permanently lobotomizes the contractee.
devil-clause-name-coherence = Coherence
devil-clause-desc-coherence = Makes the contractee clumsy and garbles their speech.
devil-clause-name-voice = Voice
devil-clause-desc-voice = Permanently mutes the contractee.
devil-clause-name-aleg = A Leg
devil-clause-desc-aleg = Severs one of the contractee's legs for good.
devil-clause-name-weight = Weight
devil-clause-desc-weight = Shrinks the contractee and stops them dragging anything.
devil-clause-name-belittling = Belittling
devil-clause-desc-belittling = Makes the contractee huge, with booming footsteps.
devil-clause-name-ahand = A Hand
devil-clause-desc-ahand = Severs one of the contractee's hands for good.
devil-clause-name-handshakes = Handshakes
devil-clause-desc-handshakes = Removes both of the contractee's arms for good.
devil-clause-name-awake = Awake
devil-clause-desc-awake = Makes the contractee narcoleptic.
devil-clause-name-anorgan = An Organ
devil-clause-desc-anorgan = Rips out one of the contractee's organs, most likely the heart.
devil-clause-name-legs = Legs
devil-clause-desc-legs = Permanently paralyzes the contractee's legs.
devil-clause-name-innerpeace = Inner Peace
devil-clause-desc-innerpeace = Grants the contractee everlasting peace.
devil-clause-name-death = Death
devil-clause-desc-death = Lets the contractee revive once after dying.
devil-clause-name-time = Time
devil-clause-desc-time = Kills the contractee after five minutes.
